# 基础启动配置
DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_MODEL=
OWNER_IDS=

# 可选模型覆盖
# “联网答疑”上下文菜单使用；不填时该功能会提示未配置。
OPENAI_SEARCH_MODEL=
# “查成分”图片 URL 检查使用；不填时回退到 OPENAI_MODEL。
URL_CHECK_MODEL=
# “大法官开庭”总结使用；不填时回退到 OPENAI_MODEL。
SUMMARY_MODEL=
SUMMARY_DISPLAY_NAME=
# 兼容旧名；优先级低于 SUMMARY_DISPLAY_NAME。
SUMMARY_MODEL_DISPLAY_NAME=
# 待办清单扫描的兼容回退模型；通常留空并使用 OPENAI_MODEL。
IMAGE_DESCRIBE_MODEL=
# 对外展示的随机模型名列表（英文逗号分隔）。
RANDOM_MODEL_NAMES=

# AI 运行时行为
DELETE_TEMP_FILES=false
MAX_PARALLEL=5

# 脑类知识库搜索配置
NAOLEI_WIKI_BASE_URL=https://naoleiwiki.pages.dev
# /问题搜索 返回条数，范围 1-50。
NAOLEI_WIKI_SEARCH_LIMIT=5

# Bot 应该驻留的服务器 ID 白名单（英文逗号分隔）。
BOT_SHOULD_IN_GUILD_IDS=1134557553011998840,1380075940285124724

# 待办清单 / 待解决帖子扫描
TARGET_FORUM_ID=
REPORT_CHANNEL_ID=
RESOLVED_TAG_ID=
UNSOLVED_TAG_ID=
RESOLVED_TAG_NAME=已解决

# 快速处罚功能配置
QUICK_PUNISH_ENABLED=false
# 可执行快速处罚的身份组 ID 列表（英文逗号分隔）。
QUICK_PUNISH_ROLES=
# 需要移除的身份组 ID 列表（英文逗号分隔）。
QUICK_PUNISH_REMOVE_ROLES=
# 日志频道 ID 列表（英文逗号分隔）。
QUICK_PUNISH_LOG_CHANNEL=
# 日志子区 ID 列表（英文逗号分隔）；也会被“查成分”日志复用。
QUICK_PUNISH_LOG_THREAD=
# 对接频道 ID。
QUICK_PUNISH_INTERFACE_CHANNEL=
# 对接机器人的用户 ID。
QUICK_PUNISH_INTERFACE_BOT_ID=
# 申诉频道 ID（在私信中提及）。
QUICK_PUNISH_APPEAL_CHANNEL=
# 重新验证说明链接（用于私信）。
QUICK_PUNISH_REVERIFY_LINK=
# 社区规则链接（用于私信）。
QUICK_PUNISH_RULES_LINK=

